# Copy file này thành deploy.env rồi điền. KHÔNG đưa deploy.env lên GitHub.
AWS_REGION=ap-southeast-1
STACK_NAME=cloudshop

# Repo GitHub công khai chứa mã nguồn (thư mục gốc repo có wsgi.py)
GitRepoUrl=https://github.com/<ten-github>/cloudshop.git
GitBranch=main
AppSubdir=.

InstanceType=t3.micro
MinSize=1
MaxSize=4
DesiredCapacity=1
CpuTargetValue=50
# Tùy chọn: thêm chính sách co giãn theo số request/phút mỗi instance (0 = tắt, chỉ co giãn theo CPU)
RequestsPerTargetValue=0

DBEngineVersion=8.4.10
DBUsername=shopadmin
# Chỉ chữ và số, 8-41 ký tự
DBPassword=DoiMatKhauNay123
# Chỉ chữ và số, tối thiểu 16 ký tự, giống nhau cho mọi instance
AppSecretKey=DoiChuoiBiMatNay2026abc
AdminPassword=Admin@2026

# Tùy chọn: email nhận thông báo khi Auto Scaling thêm/bớt instance (phải bấm Confirm trong email)
NotificationEmail=
