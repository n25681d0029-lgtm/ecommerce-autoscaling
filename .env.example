# --- Đồng bộ sản phẩm + ảnh giữa các máy (xem docs/DONG_BO_SAN_PHAM.md) ---
# Mặc định dùng thư mục catalog/ trong repo: commit & push nó lên git để máy khác thấy thay đổi.
# Khi có stack AWS, `python scripts/deploy.py` tự ghi 3 dòng dưới đây để run_local.py dùng chung S3 với AWS
# (cần AWS credentials trên máy, giống khi chạy deploy.py). `scripts/destroy.py` tự gỡ chúng.
# S3_BUCKET=cloudshop-mediabucket-xxxx
# MEDIA_BASE_URL=https://dxxxxxxxx.cloudfront.net
# AWS_REGION=ap-southeast-1
# SYNC_INTERVAL=30      # số giây giữa các lần tự đồng bộ (0 = chỉ đồng bộ lúc khởi động và khi sửa)
